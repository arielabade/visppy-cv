flowchart LR
    INPUT[Input and camera context] --> CONTRACT[Schema and metadata validation]
    CONTRACT --> DETECT[Detection observations]
    DETECT --> TRACK[Tracking and relinking]
    TRACK --> SPACE[Spatial mapping and geometry checks]
    SPACE --> EVENTS[Validated analytics events]
    EVENTS --> STORAGE[Parquet / SQL / DuckDB]
    STORAGE --> QC[Quality checks and uncertainty labels]
    QC --> OUTPUT[Aggregates, dashboards, and operational KPIs]
    QC --> REVIEW[Review or quarantine]
    REVIEW -. corrected or approved .-> OUTPUT

    classDef input fill:#F7F1E8,stroke:#1A1838,color:#181615;
    classDef transform fill:#FFF0DE,stroke:#D95F00,color:#1A1838;
    classDef quality fill:#E9F2ED,stroke:#4D927F,color:#1A1838;
    classDef output fill:#1A1838,stroke:#FF7A1A,color:#F7F1E8;
    class INPUT input;
    class CONTRACT,DETECT,TRACK,SPACE,EVENTS,STORAGE transform;
    class QC,REVIEW quality;
    class OUTPUT output;
